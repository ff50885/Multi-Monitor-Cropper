#!/usr/bin/env python3
"""cropper.core - geometry engine for seamless multi-monitor span wallpapers.

Splits a single source image into N per-panel crops (N >= 1) that, once each
is resampled to its panel's native resolution, render the artwork at one
identical physical scale (source px per cm) on every display. This compensates
for the differing pixel densities (PPI) of mixed-size monitors and keeps image
features continuous across every bezel seam.

Panels are declared left-to-right in physical desk order. Adjacent crops are
separated by a hidden strip whose width equals the configured bezel gap, so
the artwork continues "behind" the bezels. All panels share one vertical
mounting rule (top / centre / bottom edges collinear), mirroring how the real
displays are aligned on the desk.

Pure stdlib, import-only and side-effect free: this module only solves crop
geometry; pixel I/O is left to the caller.

Example:
    from PIL import Image
    from cropper.core import Cropper

    plan = Cropper((7680, 2160), panels=(24.0, 32.0, 24.0)).compute()
    for panel in plan.panels:
        tile = Image.open(src).crop(panel.crop.box()).resize(panel.target, Image.LANCZOS)
"""

from __future__ import annotations

import math
from dataclasses import dataclass
from enum import Enum
from typing import Sequence, Tuple, Union

__all__ = ["Side", "VerticalAlign", "Anchor", "CropRect", "Panel", "CropPlan",
           "Cropper"]


class Side(Enum):
    """Horizontal position of the smaller panel relative to the larger one
    (used only by the two-panel convenience constructor)."""
    LEFT = "left"
    RIGHT = "right"


class VerticalAlign(Enum):
    """Physical vertical alignment of all panels as mounted on the desk."""
    TOP = "top"         # top edges collinear
    CENTER = "center"   # vertical centres collinear
    BOTTOM = "bottom"   # bottom edges collinear (typical desk setup)


class Anchor(Enum):
    """Placement of the crop window inside the unused source-image margin."""
    START = "start"     # flush with the left/top margin edge
    CENTER = "center"   # centred within the margin
    END = "end"         # flush with the right/bottom margin edge


@dataclass(frozen=True)
class CropRect:
    """Axis-aligned crop window in source-image pixel coordinates."""
    x: int
    y: int
    width: int
    height: int

    def box(self) -> Tuple[int, int, int, int]:
        """Return a PIL-compatible (left, upper, right, lower) tuple."""
        return self.x, self.y, self.x + self.width, self.y + self.height


@dataclass(frozen=True)
class Panel:
    """One display: physical description plus its solved crop and target."""
    inch: float                  # panel diagonal, inches
    cm: Tuple[float, float]      # physical (width, height), cm
    target: Tuple[int, int]      # native resolution the crop resamples to
    crop: CropRect               # solved window in source pixels


@dataclass(frozen=True)
class CropPlan:
    """Immutable result: one solved panel per entry, left-to-right."""
    panels: Tuple[Panel, ...]
    px_per_cm: float             # common physical scale enforced everywhere


class Cropper:
    """Compute per-panel crop rectangles for an N-monitor span wallpaper.

    Core invariant: every crop is sized in source pixels proportionally to its
    panel's physical size using one shared proportionality constant
    (`px_per_cm`). After each crop is resampled to its panel's native
    resolution, one source pixel occupies exactly `1 / px_per_cm` cm on *all*
    panels, so the artwork continues across every seam without a scale jump.
    """

    _ASPECT = (16.0, 9.0)  # assumed panel aspect ratio (width, height)
    _CM_PER_INCH = 2.54    # inch-to-centimetre conversion

    def __init__(
        self,
        source: Tuple[int, int],
        panels: Sequence[float] = (32.0, 24.0),
        target: Union[Tuple[int, int], Sequence[Tuple[int, int]]] = (1920, 1080),
        align: VerticalAlign = VerticalAlign.BOTTOM,
        bezel_gap_cm: float = 0.0,
        anchor_x: Anchor = Anchor.CENTER,
        anchor_y: Anchor = Anchor.CENTER,
    ) -> None:
        """
        source       : source image size in pixels, (width, height).
        panels       : panel diagonals in inches, ordered left-to-right.
        target       : one common native resolution, or one per panel.
        align        : physical vertical mounting alignment of the panels.
        bezel_gap_cm : combined bezel width hidden at *each* seam, cm.
        anchor_x/y   : crop-window placement within the surplus source margin.
        """
        if source[0] <= 0 or source[1] <= 0:
            raise ValueError("source size must be positive")
        if not panels or any(d <= 0 for d in panels):
            raise ValueError("panel diagonals must be a non-empty positive sequence")
        if bezel_gap_cm < 0:
            raise ValueError("bezel gap must be non-negative")

        # Accept a single shared target or exactly one target per panel.
        if target and isinstance(target[0], (tuple, list)):
            targets = [tuple(t) for t in target]
            if len(targets) != len(panels):
                raise ValueError("expected one target per panel")
        else:
            targets = [tuple(target)] * len(panels)
        if any(w <= 0 or h <= 0 for w, h in targets):
            raise ValueError("target resolutions must be positive")

        self._src = source
        self._panels = tuple(float(d) for d in panels)
        self._targets = targets
        self._align = align
        self._gap = float(bezel_gap_cm)
        self._ax = anchor_x
        self._ay = anchor_y

    # ------------------------------------------------------------- public

    @classmethod
    def dual(
        cls,
        source: Tuple[int, int],
        large_inch: float = 32.0,
        small_inch: float = 24.0,
        small_side: Side = Side.RIGHT,
        **kwargs,
    ) -> "Cropper":
        """Two-panel convenience constructor mirroring the legacy API."""
        order = (large_inch, small_inch) if small_side is Side.RIGHT \
            else (small_inch, large_inch)
        return cls(source, panels=order, **kwargs)

    def compute(self) -> CropPlan:
        """Solve the crop geometry and return an immutable CropPlan."""
        cms = [self._panel_cm(d) for d in self._panels]
        seams = len(cms) - 1

        # Shared physical scale (source px per cm): the largest value for which
        # the full horizontal span (all panels + one gap per seam) and the
        # tallest panel still fit inside the source image.
        total_w_cm = sum(w for w, _ in cms) + seams * self._gap
        max_h_cm = max(h for _, h in cms)
        scale = min(self._src[0] / total_w_cm, self._src[1] / max_h_cm)

        # Crop footprints in source pixels = physical size * shared scale.
        widths = [w * scale for w, _ in cms]
        heights = [h * scale for _, h in cms]
        gap = self._gap * scale          # hidden strip per seam
        max_h = max_h_cm * scale         # window height (tallest panel)

        # Position the crop window inside the leftover source margin.
        x0 = self._offset(self._src[0] - (sum(widths) + seams * gap), self._ax)
        y0 = self._offset(self._src[1] - max_h, self._ay)

        # Horizontal layout: panels are adjacent; each gap sits exactly on a
        # seam so the hidden strip matches the physical bezel width.
        xs = []
        x = x0
        for w in widths:
            xs.append(x)
            x += w + gap

        # Vertical offset per panel mirrors the physical mounting: every crop
        # slides inside the window exactly as the real panels are aligned.
        def dy(h: float) -> float:
            return {VerticalAlign.TOP: 0.0,
                    VerticalAlign.CENTER: (max_h - h) / 2.0,
                    VerticalAlign.BOTTOM: max_h - h}[self._align]

        panels = tuple(
            Panel(inch=self._panels[i], cm=cms[i], target=self._targets[i],
                  crop=self._rect(xs[i], y0 + dy(heights[i]), widths[i], heights[i]))
            for i in range(len(cms))
        )
        return CropPlan(panels=panels, px_per_cm=scale)

    # ---------------------------------------------------------- internals

    def _panel_cm(self, diagonal_inch: float) -> Tuple[float, float]:
        """Physical panel (width, height) in cm, derived from a 16:9 diagonal."""
        unit = self._CM_PER_INCH / math.hypot(*self._ASPECT)
        return (diagonal_inch * self._ASPECT[0] * unit,
                diagonal_inch * self._ASPECT[1] * unit)

    @staticmethod
    def _offset(surplus: float, anchor: Anchor) -> float:
        """Window offset within the unused margin: zero, half, or full surplus."""
        return {Anchor.START: 0.0,
                Anchor.CENTER: surplus / 2.0,
                Anchor.END: surplus}[anchor]

    def _rect(self, x: float, y: float, w: float, h: float) -> CropRect:
        """Round to integer pixels and clamp the window to the source bounds."""
        xi, yi = int(round(x)), int(round(y))
        return CropRect(xi, yi,
                        min(int(round(w)), self._src[0] - xi),
                        min(int(round(h)), self._src[1] - yi))